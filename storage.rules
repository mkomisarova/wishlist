rules_version = '2';

// Paste this into: Firebase Console -> Storage -> Rules tab.
//
// Anyone can view photos (needed for the public site). Only a signed-in
// user (Milana, via admin.html) can upload or delete photos.
service firebase.storage {
  match /b/{bucket}/o {
    match /images/{allImages=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
